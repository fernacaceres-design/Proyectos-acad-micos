        "#inputando NA de gpa con knn\n",
        "#copia\n",
        "from sklearn.impute import KNNImputer\n",
        "\n",
        "datos_before = datos.copy()\n",
        "\n",
        "columns_to_exclude = ['IDstudent', 'IDschool']\n",
        "columns_for_imputation = datos.select_dtypes(include=[np.number]).columns.difference(columns_to_exclude)\n",
        "\n",
        "# Crear una instancia del KNNImputer\n",
        "knn_imputer = KNNImputer(n_neighbors=5)\n",
        "\n",
        "# Aplicar el KNNImputer solo a las columnas seleccionadas (sin las de ID)\n",
        "datos[columns_for_imputation] = knn_imputer.fit_transform(datos[columns_for_imputation])\n",
        "\n",
        "# Comparación antes y después en GPAin2021 solo para filas donde GPAin2021 era NA\n",
        "comparison_table = pd.DataFrame({\n",
        "    'GPAin2021_Before': datos_before['GPAin2021'],\n",
        "    'GPAin2021_After': datos['GPAin2021']\n",
        "})\n",
        "\n",
        "# Filtrar solo las filas donde originalmente había NA en GPAin2021\n",
        "comparison_table_filtered = comparison_table[comparison_table['GPAin2021_Before'].isna()]\n",
        "\n",
        "# Calcular la media de los nuevos valores imputados en GPAin2021\n",
        "mean_imputed_gpa = comparison_table_filtered['GPAin2021_After'].mean()\n",
        "\n",
        "# Añadir la media de los nuevos valores en una fila\n",
        "comparison_table_filtered = comparison_table_filtered.assign(Mean_Imputed_GPA=mean_imputed_gpa)\n",
        "\n",
        "comparison_table_filtered.head(10)\n"
      ],
