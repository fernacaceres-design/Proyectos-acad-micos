      "source": [
        "#Columnas a usar, modelos sin balanceo de clases\n",
        "columnas_relevantes = ['GPAin2021', 'AttendanceIn2021', 'GraduatedIn2021', 'ListedInDropoutReport','Migrant', 'PrioritaryStudentIn2021', 'Female', 'Age', 'DropoutDate',\"MunicipalSchool\"]\n",
        "X = datos[columnas_relevantes]\n",
        "y = datos['EnrolledByAug312022']\n",
        "\n",
        "#Procesando columnas tipo datetime transformandola a dias desde el epoch\n",
        "if 'DropoutDate' in X.columns:\n",
        "    X['DropoutDate'] = X['DropoutDate'].astype('int64') // 10**9 // (24 * 60 * 60)\n",
        "\n",
        "#Dividiendo set\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=100, stratify=y)\n",
        "\n",
        "#Roc\n",
        "def plot_roc_curve(model, X_test, y_test, model_name):\n",
        "    y_proba = model.predict_proba(X_test)[:, 1]\n",
        "    fpr, tpr, _ = roc_curve(y_test, y_proba)\n",
        "    auc = roc_auc_score(y_test, y_proba)\n",
        "    plt.plot(fpr, tpr, label=f\"{model_name} (AUC = {auc:.2f})\")\n",
        "    return auc\n",
        "\n",
        "#Matriz confusion y metricas\n",
        "def save_confusion_matrix(model, X_test, y_test, model_name):\n",
        "    y_pred = model.predict(X_test)\n",
        "    cm = confusion_matrix(y_test, y_pred)\n",
        "    disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=model.classes_)\n",
        "    disp.plot(cmap=plt.cm.Blues)\n",
        "    plt.title(f\"Matriz de Confusión - {model_name}\")\n",
        "    plt.savefig(f\"{model_name}_confusion_matrix.png\")  # Guardar como PNG\n",
        "    plt.close()  # Cerrar para evitar sobreescritura en otras figuras\n",
        "    print(f\"Matriz de Confusión guardada como {model_name}_confusion_matrix.png\")\n",
        "    print(f\"Accuracy:  {accuracy_score(y_test, y_pred):.4f}\")\n",
        "    print(f\"Precision: {precision_score(y_test, y_pred):.4f}\")\n",
        "    print(f\"Recall:    {recall_score(y_test, y_pred):.4f}\")\n",
        "    print(f\"F1-Score:  {f1_score(y_test, y_pred):.4f}\")\n",
        "\n",
        "plt.figure(figsize=(10, 7))\n",
        "\n",
        "# 1. Regresión Logística\n",
        "log_model = LogisticRegression(random_state=100, solver='lbfgs', max_iter=1000)\n",
        "log_model.fit(X_train, y_train)\n",
        "auc_log = plot_roc_curve(log_model, X_test, y_test, \"Regresión Logística\")\n",
        "save_confusion_matrix(log_model, X_test, y_test, \"Regresión Logística\")\n",
        "\n",
        "# 2. Random Forest\n",
        "rf_model = RandomForestClassifier(random_state=100, n_estimators=100, max_depth=None)\n",
        "rf_model.fit(X_train, y_train)\n",
        "auc_rf = plot_roc_curve(rf_model, X_test, y_test, \"Random Forest\")\n",
        "save_confusion_matrix(rf_model, X_test, y_test, \"Random Forest\")\n",
        "\n",
        "# 3. XGBoost\n",
        "xgb_model = XGBClassifier(random_state=100, n_estimators=100, learning_rate=0.1, max_depth=6, subsample=0.8, colsample_bytree=0.8)\n",
        "xgb_model.fit(X_train, y_train)\n",
        "auc_xgb = plot_roc_curve(xgb_model, X_test, y_test, \"XGBoost\")\n",
